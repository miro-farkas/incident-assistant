#!/bin/sh
# Rejects commits made directly on the protected branch. All work happens on a
# separate branch that is merged into the protected branch afterwards.

protected_branch="master"
current_branch=$(git symbolic-ref --short -q HEAD)

if [ "$current_branch" = "$protected_branch" ]; then
  echo "Direct commits to '$protected_branch' are not allowed." >&2
  echo "Create a branch first, for example:" >&2
  echo "  git switch -c feat/inc-001-project-skeleton" >&2
  exit 1
fi
